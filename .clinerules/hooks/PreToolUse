#!/usr/bin/env bash
# PreToolUse hook for this project.
# Receives JSON on stdin describing the tool Cline is about to run, and must
# print JSON back: {"cancel": bool, "errorMessage": "...", "contextModification": "..."}
#
# This does NOT govern the project's own Agent/Actioner loop (that's a
# separate runtime, protected instead by agents/tool_schemas.py). This hook
# only protects the repo while Cline itself is editing/running commands.

input=$(cat)

tool_name=$(echo "$input" | grep -o '"tool_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -E 's/.*:"([^"]*)"/\1/')
command_str=$(echo "$input" | grep -o '"command"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -E 's/.*:"([^"]*)"/\1/')
file_path=$(echo "$input" | grep -oE '"(path|file_path)"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -E 's/.*:"([^"]*)"/\1/')
cwd_field=$(echo "$input" | grep -oE '"cwd"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -E 's/.*:"([^"]*)"/\1/')

# 1. Never let Cline hand-edit results/raw/ -- it's append-only experimental
#    record per 03-project-conventions.md.
if [[ "$file_path" == *"results/raw/"* ]]; then
  echo '{"cancel": true, "errorMessage": "results/raw/ is append-only (never overwritten by design). If you need to fix a bad record, add a correction script instead of hand-editing the file."}'
  exit 0
fi

# 2. Never let Cline hand-edit a cloned/checked-out SWE-bench repo -- those
#    are disposable clones managed by setup_repo()/ensure_repo_environment,
#    not project source.
if [[ "$file_path" == *"seed_repos/"*"/repos/"* ]] || [[ "$file_path" == *"seed_repos/repos/"* ]]; then
  echo '{"cancel": true, "errorMessage": "This path is inside a cloned/checked-out SWE-bench repo (seed_repos/.../repos/...). These are disposable and managed by setup_repo()/ensure_repo_environment -- edit project code instead, not the clone itself."}'
  exit 0
fi

# 3. When Cline touches the Agent-loop's read_file implementation, surface
#    the already-diagnosed line-range bug so it doesn't have to rediscover
#    it from scratch: read_file currently accepts start_line/end_line but
#    doesn't apply them to the returned slice, so it keeps returning the
#    same truncated ~300-line view no matter what range is requested. This
#    is why nested-CompoundModel logic near the end of separable.py (past
#    line 300) was never actually visible to the benchmarked agent in the
#    astropy-12907 trace -- not a reasoning failure, a tool bug.
if [[ "$file_path" == *"tool_schemas.py"* ]] || [[ "$file_path" == *"read_file"* ]]; then
  echo '{"cancel": false, "contextModification": "Heads up: read_file has a known bug where start_line/end_line are accepted but not applied to the returned slice -- it always returns the same truncated view regardless of the requested range, silently hiding content past the truncation point from the agent. If you are touching this function, check the slicing logic against the requested offsets, and add a regression test that reads a file >300 lines with a start_line beyond the first page to confirm the fix actually changes the output."}'
  exit 0
fi

# 4. Warn (but do not block) on a full, unlimited benchmark run.
if [[ "$command_str" == *"run_experiment.py"* ]] && [[ "$command_str" != *"--limit"* ]]; then
  echo '{"cancel": true, "errorMessage": "This looks like a full, unlimited benchmark run (no --limit). Per ACTIONPLAN.md section 14, verify with --limit 1, then --limit 5/10 first. Re-run with --limit if you really mean to run everything, or ask the user to confirm an unlimited run explicitly."}'
  exit 0
fi

if [[ "$command_str" == *"run_grid_search.py"* ]] && [[ "$command_str" != *"--dry-run"* ]] && [[ "$command_str" != *"--limit"* ]]; then
  echo '{"cancel": true, "errorMessage": "Grid search without --dry-run or --limit will run every reasoner x actioner combination against the FULL dataset. Run --dry-run first (see the run-grid-search workflow)."}'
  exit 0
fi

# 5. Require a verified environment-build marker before letting a test
#    command run against a cloned SWE-bench repo. This targets the
#    "ImportError: ... without building the extension modules first"
#    failure mode directly: instead of letting Cline run pytest, watch it
#    fail with a confusing collection error, and re-diagnose from scratch
#    (as qwen3.5:9b did across 6 wasted iterations in the astropy-12907
#    trace), we gate the run on a marker file that setup_repo()/
#    ensure_repo_environment is expected to touch once the build actually
#    succeeds. NOTE: this requires that build step to create
#    <repo_root>/.env_ready on success -- if nothing ever touches that
#    marker, this check will block pytest forever. See ACTIONPLAN.md
#    "environment setup" section.
is_test_command() {
  local s="$1"
  [[ "$s" =~ (^|[^a-zA-Z0-9_/.-])(pytest|py\.test)([^a-zA-Z0-9_-]|$) ]] && return 0
  [[ "$s" =~ python3?[[:space:]]+-m[[:space:]]+pytest ]] && return 0
  [[ "$s" =~ (^|[[:space:]])tox([[:space:]]|$) ]] && return 0
  return 1
}

is_build_command() {
  local s="$1"
  [[ "$s" == *"pip install -e ."* ]] && return 0
  [[ "$s" == *"build_ext"* ]] && return 0
  [[ "$s" == *"setup_repo"* ]] && return 0
  [[ "$s" == *"ensure_repo_environment"* ]] && return 0
  return 1
}

cd_in_cmd=$(echo "$command_str" | grep -oE 'cd[[:space:]]+[^&;]+' | head -1 | sed -E 's/^cd[[:space:]]+//')

candidate_path=""
for p in "$file_path" "$cwd_field" "$cd_in_cmd" "$command_str"; do
  if [[ "$p" == *"seed_repos/"*"/repos/"* ]]; then
    candidate_path="$p"
    break
  fi
done

if [[ -n "$candidate_path" ]] && is_test_command "$command_str" && ! is_build_command "$command_str"; then
  repo_root=$(echo "$candidate_path" | grep -oE '.*seed_repos/[^/]+/repos/[^/]+' | head -1)
  if [[ -n "$repo_root" ]]; then
    marker="$repo_root/.env_ready"
    if [[ ! -f "$marker" ]]; then
      echo "{\"cancel\": true, \"errorMessage\": \"No .env_ready marker found at $marker, meaning this repo's environment (e.g. compiled C extensions) may never have been built. Running the test command now is likely to fail with an unbuilt-extensions ImportError rather than give a real test result. Run the repo's build/install step first -- setup_repo()/ensure_repo_environment, or 'pip install -e . --no-build-isolation' -- which should create $marker on success, then re-run the test command.\"}"
      exit 0
    fi
  fi
fi

# 6. Block obviously destructive commands anywhere in the repo.
if [[ "$command_str" =~ rm[[:space:]]+-rf[[:space:]]+(/|\.\.|seed_repos[^/]*$) ]]; then
  echo '{"cancel": true, "errorMessage": "Blocked a broad recursive delete. Scope the rm -rf to a specific instance/workspace subdirectory instead."}'
  exit 0
fi

# 7. Overnight code-improvement loop guardrails (see
#    overnight-code-improvement-loop.md): never push, merge, or commit
#    directly to main/master, regardless of what an unattended loop decides
#    is a good idea at 3am.
if [[ "$command_str" =~ git[[:space:]]+push ]] ; then
  echo '{"cancel": true, "errorMessage": "Blocked: this project never auto-pushes. The overnight code-improvement loop leaves commits on a local branch for manual review -- push it yourself after reviewing."}'
  exit 0
fi

if [[ "$command_str" =~ git[[:space:]]+(checkout|merge|rebase)[[:space:]]+.*(main|master) ]]; then
  echo '{"cancel": true, "errorMessage": "Blocked: never switch to or merge into main/master during an autonomous loop. Stay on the overnight/<date> branch and let the user merge manually."}'
  exit 0
fi

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [[ "$command_str" =~ git[[:space:]]+commit ]] && [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
  echo '{"cancel": true, "errorMessage": "Blocked: current branch is main/master. Create an overnight/<date> branch before committing (see overnight-code-improvement-loop.md)."}'
  exit 0
fi

echo '{"cancel": false}'